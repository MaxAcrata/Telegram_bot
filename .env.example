# Telegram
TELEGRAM_BOT_TOKEN=токен_от_BotFather
TELEGRAM_CHAT_ID=123456789
ADMIN_IDS=123456789

# Database (авто: /data/bot.db на Amvera, ./bot.db локально)
# DB_PATH=/data/bot.db

# Отчёты
OVERDUE_DAYS=3
REPORT_HOUR=9
REPORT_MINUTE=0

# Часовой пояс (IANA, например Europe/Moscow). Пусто = UTC.
# REPORT_TIMEZONE=Europe/Moscow

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SEC=60

# Тайм-аут текстовых сценариев (сек, минимум 30)
CONVERSATION_TIMEOUT_SEC=600

# HTTP-тайм-ауты Telegram API (сек, минимум 1)
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30
HTTP_POOL_TIMEOUT=5
# Read-timeout для getUpdates/long polling (должен превышать 10 сек PTB)
HTTP_GETUPDATES_READ_TIMEOUT=60
# Пул соединений обычного API: пусто = дефолт PTB; если задана — минимум 32
# HTTP_API_POOL_SIZE=32

# Ограничения полей
MAX_FIELD_LENGTH=500
MAX_PHOTOS_PER_REQUEST=5

# Резервные копии
# BACKUP_DIR=backups

# Прокси (опционально)
# SOCKS5_PROXY=socks5://127.0.0.1:1080