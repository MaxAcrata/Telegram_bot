# Telegram
TELEGRAM_BOT_TOKEN=токен_от_BotFather
TELEGRAM_CHAT_ID=123456789
ADMIN_IDS=123456789

# Database (по умолчанию /data/bot.db на cloud, bot.db локально)
# DB_PATH=/data/bot.db

# Отчёты
OVERDUE_DAYS=3
REPORT_HOUR=9
REPORT_MINUTE=0

# Часовой пояс (IANA, например Europe/Moscow). Пусто = UTC.
# REPORT_TIMEZONE=Europe/Moscow

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SEC=60

# Ограничения полей
MAX_FIELD_LENGTH=500
MAX_PHOTOS_PER_REQUEST=5

# Резервные копии
# BACKUP_DIR=backups

# Прокси (опционально)
# SOCKS5_PROXY=socks5://127.0.0.1:1080